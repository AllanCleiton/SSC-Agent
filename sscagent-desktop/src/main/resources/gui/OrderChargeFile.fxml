<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" styleClass="order-charge-file" stylesheets="@../css/OrderChargeFile.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.allancleitonppma.sscagent.desktop.controller.OrderChargeFileController">

    <HBox spacing="10.0" styleClass="import-bar">

        <TextField fx:id="txtImportPath" promptText="Caminho do aquivo" styleClass="text-field" HBox.hgrow="ALWAYS" />

        <Button fx:id="btnLoaderFile" onAction="#onLoaderAction" text="Abrir" />
        <Button fx:id="btnConsolidate" onAction="#onBtnConsolidateAction" text="Consolidar" />

        <Label text="Status:" />

        <Label fx:id="lbStatus" styleClass="import-status" text="Aguardando..." />

    </HBox>
    <TableView fx:id="tableViewOrderCharge" styleClass="order-table" VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="tableColumnProduct" maxWidth="-1.0" minWidth="100" prefWidth="-1.0" text="CÓD. PRODUTO" />

            <TableColumn fx:id="tableColumNeed" maxWidth="-1.0" minWidth="100" prefWidth="-1.0" text="NECESSIDADE" />

            <TableColumn fx:id="tableColumnOrder" maxWidth="-1.0" minWidth="100" prefWidth="-1.0" text="PEDIDO" />

            <TableColumn fx:id="tableColumnCondition" maxWidth="-1.0" minWidth="160.0" prefWidth="-1.0" text="CONDIÇÃO" />

            <TableColumn fx:id="tableColumnInstruction" maxWidth="-1.0" minWidth="300.0" prefWidth="-1.0" text="INSTRUÇÃO" />
         <TableColumn maxWidth="-1.0" minWidth="200.0" prefWidth="-1.0" text="STATUS" />

        </columns>

    </TableView>
   <HBox spacing="10.0" styleClass="import-bar">
      <children>
         <TextField fx:id="txtNewCondition" promptText="Inserir condição" HBox.hgrow="ALWAYS" />
         <TextField fx:id="txtNewCode" prefWidth="80.0" promptText="Código" />
         <TextField fx:id="txtNewQuantity" prefWidth="80.0" promptText="Quantidade" />
         <TextField fx:id="txtNewOrder" prefWidth="80.0" promptText="Pedido" />
         <Button fx:id="btnLoaderFile1" onAction="#onNewOrderAction" text="Aplicar" />
         <Label text="Status:" />
         <Label fx:id="lbStatusApply" prefHeight="17.0" prefWidth="79.0" styleClass="import-status" text="Aguardando..." HBox.hgrow="NEVER" />
      </children>
   </HBox>

</VBox>
