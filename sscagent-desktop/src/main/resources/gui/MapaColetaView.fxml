                                          <ToggleButton styleClass="stock-position" text="" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                      </HBox>
            
                  
                                      <!-- LINHA 4 -->
            
                                      <HBox alignment="CENTER" spacing="5">
            
                                          <ToggleButton styleClass="stock-position" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                      </HBox>
            
                  
                                      <!-- LINHA 5 -->
            
                                      <HBox alignment="CENTER" spacing="5">
            
                                          <ToggleButton styleClass="stock-position" text="3A / 356" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                      </HBox>
            
                  
                                      <!-- LINHA 6 -->
            
                                      <HBox alignment="CENTER" spacing="5">
            
                                          <ToggleButton selected="true" styleClass="stock-position" text="2A / 213" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                      </HBox>
            
                  
                                      <!-- LINHA 7 -->
            
                                      <HBox alignment="CENTER" spacing="5">
            
                                          <ToggleButton selected="true" styleClass="stock-position" text="1A / 236" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                          <ToggleButton styleClass="stock-position" text="" />
            
                                      </HBox>
                        </children>
                     </VBox>
                  </children>
               </HBox>

                </VBox>

            </ScrollPane>

        </VBox>

    </HBox>


    <!-- =========================================================
         RODAPÉ / PALETE SELECIONADO
         ========================================================= -->

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="selection-bar">

        <Label styleClass="selected-pallet" text="Palete selecionado: P01" />

        <Region HBox.hgrow="ALWAYS" />

        <Label styleClass="selected-map" text="MAPA 0001" />


        <Label styleClass="quantity-label" text="Quantidade:" />

        <Spinner editable="true" prefWidth="90" />

        <Label styleClass="quantity-label" text="caixas" />


        <Button styleClass="remove-button" text="Remover do mapa" />

    </HBox>

</VBox>
