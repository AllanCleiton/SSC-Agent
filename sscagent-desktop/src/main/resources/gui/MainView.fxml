<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="780.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.allancleitonppma.sscagent.desktop.controller.MainViewController">

    <!-- =====================================================
         TOPO
         ===================================================== -->

    <top>
        <VBox>
            <!-- MENU -->
            <MenuBar>
                <menus>
                    <Menu mnemonicParsing="false" text="Cadastro">
                        <items>
                            <MenuItem mnemonicParsing="false" text="Close" />
                        </items>
                    </Menu>
                    <Menu mnemonicParsing="false" text="Editar">
                        <items>
                            <MenuItem mnemonicParsing="false" text="Delete" />
                        </items>
                    </Menu>
                    <Menu mnemonicParsing="false" text="Ajuda">
                        <items>
                            <MenuItem mnemonicParsing="false" text="About" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>


            <!-- CABEÇALHO -->
            <HBox styleClass="header">

                <VBox HBox.hgrow="ALWAYS">
                    <Label styleClass="title" text="SSC AGENT" />
                    <Label styleClass="subtitle" text="Sistema de Separação de Carga" />
                </VBox>
                <Label styleClass="header-status" text="Pronto para importar dados" />
            </HBox>
        </VBox>
    </top>


    <!-- =====================================================
         CENTRO
         ===================================================== -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <tabs>
                <!--Aba Ordem de Carga-->
                <Tab fx:id="tabOrderDeCarga" onSelectionChanged="#onTabOrderDeCargaAction" text="Ordem de Carga">
                    <content>
                        <VBox spacing="10.0">
                             <VBox prefHeight="200.0" prefWidth="100.0">
                                <children>
                                                <!-- ÁREA SUPERIOR -->
                                    <HBox spacing="10.0" styleClass="status-bar">
                                        <!--Item da area superior-->
                                        <Label text="Informe o diretório           " />
                                        <TextField fx:id="txtImportPath" />
                                        <Button fx:id="btnLoaderFile" mnemonicParsing="false" onAction="#OnOpenFileAction" prefWidth="60.0" text="Abrir" />
                                        <Label text="Status:" />
                                        <Label fx:id="lbFileStatus" text="Aguardando..." />
                                        <VBox.margin>
                                            <Insets top="5.0" />
                                        </VBox.margin>
                                    </HBox>

                                      <HBox spacing="10.0" styleClass="status-bar" visible="true" >
                                          <!--Item da area superior-->
                                          <Label text="Informe a ordem de carga" />
                                          <TextField fx:id="txtOrderCharger" />
                                          <Button fx:id="btnLoader" mnemonicParsing="false" onAction="#onLoaderAction" text="Carregar" />
                                          <Label text="Status:" />
                                          <Label fx:id="lbStatus" text="Aguardando..." />
                                          <VBox.margin>
                                             <Insets top="5.0" />
                                          </VBox.margin>
                                      </HBox>

                                 </children>
                             </VBox>


                            <!-- TABELA -->
                            <TableView fx:id="tbOrderChargeList" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="tableColumnProduct" prefWidth="112.0" text="CÓD. PRODUTO" />

                                    <TableColumn fx:id="tableColumNeed" prefWidth="106.0" text="NECESSIDADE" />

                                    <TableColumn fx:id="tableColumnCondition" prefWidth="107.0" text="CONDIÇÃO" />

                                    <TableColumn fx:id="tableColumnOrder" prefWidth="111.0" text="PEDIDO" />

                                    <TableColumn fx:id="tableColumnInstruction" prefWidth="339.0" text="INSTRUÇÃO" />
                                </columns>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

                <!--Aba Mapa de Coleta-->
                <Tab text="Mapa de coleta">
                    <content>
                        <AnchorPane />
                    </content>
                </Tab>
                <!--Aba Perfis de Coleta-->
                <Tab text="Perfis de coleta">
                    <content>
                        <AnchorPane />
                    </content>
                </Tab>
                <!--Aba Gestão de Endereços-->
                <Tab text="Endereços">
                    <content>
                        <AnchorPane />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>


    <!-- =====================================================
         RODAPÉ / STATUS BAR
         ===================================================== -->

    <bottom>

        <HBox styleClass="status-bar">

            <Label prefHeight="30.0" prefWidth="85.0" text="Modo de dados" />

            <ComboBox fx:id="comboBoxDataMode" prefHeight="11.0" prefWidth="150.0" />

            <Label styleClass="status-ok" text="● Pronto" />

        </HBox>

    </bottom>

</BorderPane>
