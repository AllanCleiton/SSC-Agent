<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" styleClass="order-charge-file" stylesheets="@../css/OrderChargeFile.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.allancleitonppma.sscagent.desktop.controller.OrderChargeExcelController">

    <HBox spacing="10.0" styleClass="import-bar">

        <Label text="Informe o diretório" />

        <TextField fx:id="txtImportPath" HBox.hgrow="ALWAYS" />

        <Button fx:id="btnLoaderFile" onAction="#onLoaderAction" text="Abrir" />

        <Label text="Status:" />

        <Label fx:id="lbStatus" styleClass="import-status" text="Aguardando..." />

    </HBox>
    <TableView fx:id="tableViewOrderCharge" styleClass="order-table" VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="tableColumnProduct" minWidth="100" text="CÓD. PRODUTO" />

            <TableColumn fx:id="tableColumNeed" minWidth="100" text="NECESSIDADE" />

            <TableColumn fx:id="tableColumnOrder" minWidth="100" text="PEDIDO" />

            <TableColumn fx:id="tableColumnCondition" minWidth="100" prefWidth="164.0" text="CONDIÇÃO" />

            <TableColumn fx:id="tableColumnInstruction" minWidth="136.0" prefWidth="144.0" text="INSTRUÇÃO" />
         <TableColumn fx:id="tableColumnInstruction1" minWidth="136.0" prefWidth="144.0" text="AÇÃO" />

        </columns>

    </TableView>
   <HBox spacing="10.0" styleClass="import-bar">
      <children>
         <TextField fx:id="txtNewCondition" promptText="Inserir condição" HBox.hgrow="ALWAYS" />
         <TextField fx:id="txtNewCode" prefWidth="80.0" promptText="Código" />
         <TextField fx:id="txtNewQuantity" prefWidth="80.0" promptText="Quantidade" />
         <TextField fx:id="txtNewOrder" prefWidth="80.0" promptText="Pedido" />
         <Button fx:id="btnLoaderFile1" onAction="#onNewOrderAction" text="Aplicar" />
         <Label text="Status:" />
         <Label fx:id="lbStatusApply" styleClass="import-status" text="Aguardando..." />
      </children>
   </HBox>

</VBox>
